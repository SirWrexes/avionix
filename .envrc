root="$(git rev-parse --show-toplevel)"
branch="$(git branch --show-current)"

# Watch all git-tracked top-level directories
mapfile -t tracked < <(git -C "$root" ls-tree --name-only -d "$branch")
for dir in "${tracked[@]}"; do
  watch_dir "$root/$dir"
done

declare -a tracked=(
  # Since we care about what is tracked, we should care about changes to what is excluded from tracking.
  .gitignore
)
for file in "${tracked[@]}"; do
  watch_file "$root/$file"
done

use flake
