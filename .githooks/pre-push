#! /usr/bin/env bash
#  kate: syntax bash;

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

FLAKE_REV="$(git rev-parse HEAD)"

BUILD_DIR="build/docs"
FEATURES_DIR="modules/features"

DOCS_MARKDOWN="$BUILD_DIR/options.md"
DOCS_GENERATED="$FEATURES_DIR/README.md"

export FLAKE_REV

if git diff --quiet --staged origin/main -- "$FEATURES_DIR" ":(exclude)$DOCS_GENERATED"; then
  # skip docs generation silently
  exit 0
fi

# Some files might be partially committed.
# We want to run the docs generation on only the parts that are going to be pushed, so we stash the rest.
HAS_STASH=0
if [ -n "$(git status --porcelain -- "$FEATURES_DIR" ":(exclude)$DOCS_GENERATED")" ]; then
  echo "📥 Stash changes not staged"
  git stash push --quiet --keep-index -u -m "pre-push-autostash" || true
  HAS_STASH=1
fi

trap '
if [ "$HAS_STASH" -eq 1 ]; then
  echo "📤 Pop it like it'"'"'s hot"
  git stash pop --quiet || true;
fi
' EXIT

echo "🔨 Build latest flake module docs"
nix --extra-experimental-features "flakes nix-command" \
  build .#docs.optionsCommonMark \
  --offline \
  --impure \
  -o "$DOCS_MARKDOWN"

echo "📝 Overwrite old docs"
cat "$DOCS_MARKDOWN" >"$DOCS_GENERATED"

echo "📦 Commit doc changes"
git add -- "$DOCS_GENERATED"
git commit -m "doc(modules): Auto-generate docs" -- "$DOCS_GENERATED"

echo "✅ Docs generated and committed successfully, please push again."
